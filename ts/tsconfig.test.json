{
  // The circuit regression tests run under Node (they read and record the circuits in fixtures/),
  // so they're type-checked here with Node types instead of with the browser app in tsconfig.json.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vite/client"]
  },
  "include": ["AutoTests.test.ts", "CircuitRegression.test.ts"],
  "exclude": ["old", "node_modules"]
}
