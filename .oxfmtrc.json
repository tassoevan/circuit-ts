{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "overrides": [
    {
      "files": ["*.ts", "*.js", "*.mjs", "*.css"],
      "options": { "tabWidth": 4 }
    }
  ],
  "ignorePatterns": [
    "war/",
    "websocket/",
    "ts/fixtures/",
    "ts/public/",
    "ts/canvas2svg.js",
    "package-lock.json"
  ]
}
